[Unit]
Description=FL Studio: check, repair and pre-build the wineserver pool fix
StartLimitIntervalSec=1d
StartLimitBurst=6
Documentation=file://@REPO@/docs/updating.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash @REPO@/scripts/poolfix-maintain.sh
# Builds must not disturb a running audio session
Nice=15
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
TimeoutStartSec=45min
# On failure (e.g. no network): retry after 20 min, at most 6 times a day
Restart=on-failure
RestartSec=20min
