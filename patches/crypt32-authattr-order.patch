+/* A signature covers the authenticated attributes exactly as the signer
+ * encoded them. Re-encoding them as PKCS_ATTRIBUTES sorts them (DER SET OF),
+ * which changes the hash for signers that don't emit them sorted - e.g. the
+ * Authenticode signatures of FL Studio 26.1.7. Windows accepts those, so
+ * verification encodes them in their original order.
+ */
+static BOOL CRYPT_EncodeAttributesInOrder(const CRYPT_ATTRIBUTES *attrs,
+ BYTE **encoded, DWORD *size)
+{
+    BYTE **items;
+    DWORD *sizes, i, n, len = 0, lenBytes;
+    BOOL ret = TRUE;
+
+    if (!(items = CryptMemAlloc(attrs->cAttr * (sizeof(*items) + sizeof(*sizes)))))
+        return FALSE;
+    sizes = (DWORD *)(items + attrs->cAttr);
+    for (n = 0; ret && n < attrs->cAttr; n++)
+    {
+        ret = CryptEncodeObjectEx(X509_ASN_ENCODING, PKCS_ATTRIBUTE,
+         &attrs->rgAttr[n], CRYPT_ENCODE_ALLOC_FLAG, NULL, &items[n], &sizes[n]);
+        if (ret)
+            len += sizes[n];
+        else
+            break;
+    }
+    if (ret)
+    {
+        CRYPT_EncodeLen(len, NULL, &lenBytes);
+        *size = 1 + lenBytes + len;
+        if ((*encoded = LocalAlloc(0, *size)))
+        {
+            BYTE *out = *encoded;
+
+            *out++ = ASN_CONSTRUCTOR | ASN_SETOF;
+            CRYPT_EncodeLen(len, out, &lenBytes);
+            out += lenBytes;
+            for (i = 0; i < n; i++)
+            {
+                memcpy(out, items[i], sizes[i]);
+                out += sizes[i];
+            }
+        }
+        else
+            ret = FALSE;
+    }
+    for (i = 0; i < n; i++)
+        LocalFree(items[i]);
+    CryptMemFree(items);
+    return ret;
+}
